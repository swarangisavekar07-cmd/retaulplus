# =====================================================================
# RetailPulse AI — Environment Configuration Example
# =====================================================================
# Copy this file to .env and customize values for your deployment.
# NEVER commit the active .env file or GCP service account credentials.
# =====================================================================

# 1. PostgreSQL Source Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=retail_pulse_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_pass

# 2. Airbyte API & Orchestration
AIRBYTE_HOST=localhost
AIRBYTE_PORT=8000
AIRBYTE_USERNAME=airbyte
AIRBYTE_PASSWORD=password
AIRBYTE_CONNECTION_ID=your-airbyte-connection-uuid-here

# 3. Google Cloud BigQuery Data Warehouse
GCP_PROJECT_ID=your-gcp-project-id
GCP_LOCATION=US
BIGQUERY_RAW_DATASET=raw_retailpulse
BIGQUERY_RAW_TABLE=retail_sales
BIGQUERY_ANALYTICS_DATASET=analytics_retailpulse
GOOGLE_APPLICATION_CREDENTIALS=config/gcp-key.json

# 4. Streamlit Application
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0

# 5. Optional LLM Integration for Conversational BI
# GEMINI_API_KEY=your-gemini-api-key-here
# OPENAI_API_KEY=your-openai-api-key-here
